            #WRITE_IFP(A9 01E0) 
              #WRITE_IFP(A7 0080) 
            #WRITE_IFP(AA 0060)
                #WRITE_IFP(AE 0C09)
                #FRAME_RATE_AUTO
                $c9 01
                    #WRITE_CONTROL(37 0120) //15 fps 
            #WRITE_CONTROL(2E 0000) //target 0 
           $d0064//pause 100 ms ms (Old 1000) 
           #WRITE_CONTROL(2E 0C4A)
                  $cl    
                    
                    
                  $cx
                    $"DORISsetuptest_VF32"    
                    ;

